# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/air
# Enable for hosted databases. TiDB Cloud always enables verified TLS.
DATABASE_SSL=false
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register http://localhost:3000/api/oauth/callback in Google Cloud.
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:3000
OWNER_EMAIL=
# For a separately hosted frontend, set its HTTPS backend origin at build time
# or in air-config.js. Leave empty for a single-host deployment.
VITE_API_ORIGIN=
# Optional: required only for existing media uploads, not project text or links.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
